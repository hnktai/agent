# ==============================================================================
# GoClaw Production Environment Configuration for agent.hnkt.vn
# ==============================================================================

# [BẮT BUỘC] Tự động sinh khi chạy ./prepare-env.sh
# Token quản trị đăng nhập trên giao diện web (giữ bí mật)
GOCLAW_GATEWAY_TOKEN=

# Khóa mã hóa AES-256-GCM bảo vệ các API key lưu trong cơ sở dữ liệu
GOCLAW_ENCRYPTION_KEY=

# [POSTGRESQL]
POSTGRES_USER=goclaw
POSTGRES_DB=goclaw
POSTGRES_PASSWORD=your_strong_random_password_here
POSTGRES_PORT=5432

# [CỔNG GOCLAW]
# Mặc định bind cổng 18790 để Nginx proxy_pass vào
GOCLAW_PORT=18790
GOCLAW_HOST=0.0.0.0

# [CẤU HÌNH API KEYS LLM - Tùy chọn điền trước hoặc điền qua giao diện Web]
# GOCLAW_OPENROUTER_API_KEY=
# GOCLAW_OPENAI_API_KEY=
# GOCLAW_GEMINI_API_KEY=
# GOCLAW_ANTHROPIC_API_KEY=
# GOCLAW_GROQ_API_KEY=
# GOCLAW_DEEPSEEK_API_KEY=

# [THÔNG BÁO / CHANNELS - Tùy chọn]
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
